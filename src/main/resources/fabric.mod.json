{
  "schemaVersion": 1,
  "id": "cubicchunks",
  "version": "${version}",
  "name": "CubicChunks",
  "description": "Cubic Chunks for Fabric 26.2. Removes fixed vertical world limits by storing and loading three-dimensional cubes.",
  "authors": [
    "Barteks2x",
    "Byanca"
  ],
  "contact": {
    "sources": "https://github.com/Memphis-Cat/minecraftinf",
    "issues": "https://github.com/Memphis-Cat/minecraftinf/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.opencubicchunks.cubicchunks.CubicChunks"
    ],
    "client": [
      "io.github.opencubicchunks.cubicchunks.network.CCClientNetworkHandler"
    ]
  },
  "mixins": [
    "cubicchunks.mixins.core.json",
    "cubicchunks.mixins.access.json"
  ],
  "accessWidener": "cubicchunks.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.156.0"
  },
  "custom": {
    "cubicchunks:dasm": "cubicchunks.dasm.json"
  }
}
